# Experiment B2: the baseline flags, serving the FP8 checkpoint produced by
# scripts/quantize/quantize.py (start with
# `./engine.sh up b2-fp8 /models/Qwen2.5-7B-Instruct-FP8-Dynamic`). vLLM reads
# the quantization from the checkpoint's config, so no --quantization flag.
ENGINE_ARGS=--gpu-memory-utilization 0.90 --max-model-len 8192 --max-num-seqs 256 --max-num-batched-tokens 2048
